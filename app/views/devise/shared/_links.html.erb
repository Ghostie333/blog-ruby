<%- if controller_name != 'sessions' %>
  <p><%= link_to t('devise.sign_in_link'), new_session_path(resource_name) %></p>
<% end %>
<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p class="p-2"><%= link_to t('devise.sign_up_link'), new_registration_path(resource_name), class: "p-2" %></p>
<% end %>
<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="p-2"><%= link_to t('devise.forgot_password_link'), new_password_path(resource_name), class: "p-2" %></p>
<% end %>
<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p><%= link_to t('devise.didnt_receive_confirmation'), new_confirmation_path(resource_name) %></p>
<% end %>
<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p><%= link_to t('devise.didnt_receive_unlock'), new_unlock_path(resource_name) %></p>
<% end %>
<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <p><%= button_to t('devise.sign_in_with', provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false } %></p>
  <% end %>
<% end %>