<div class="mx-auto my-12 w-full max-w-2xl space-y-8">
  
  <%# KARTA 1: Główny formularz edycji %>
  <div class="p-8 bg-white border border-gray-100 rounded-2xl shadow-xl">
    <div class="mb-8">
      <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Edycja profilu</h2>
      <p class="text-sm text-gray-500 mt-2">Zaktualizuj swoje dane profilowe lub zmień hasło.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      
      <%# Render błędów walidacji (jeśli są) %>
      <% if resource.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm">
          <%= render "devise/shared/error_messages", resource: resource %>
        </div>
      <% end %>

      <%# Pole: Email %>
      <div class="space-y-2">
        <%= f.label :email, "Adres e-mail", class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, 
                          autofocus: true, 
                          autocomplete: "email", 
                          class: "block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition duration-150" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="p-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl text-xs">
          Oczekiwanie na potwierdzenie zmiany adresu na: <strong class="font-semibold"><%= resource.unconfirmed_email %></strong>
        </div>
      <% end %>

      <hr class="border-gray-100 my-4" />

      <%# Pole: Nowe Hasło %>
      <div class="space-y-2">
        <div class="flex justify-between items-baseline">
          <%= f.label :password, "Nowe hasło", class: "block text-sm font-medium text-gray-700" %>
          <span class="text-xs text-gray-400 italic">Zostaw puste, jeśli nie chcesz zmieniać</span>
        </div>
        <%= f.password_field :password, 
                             autocomplete: "new-password", 
                             placeholder: "••••••••",
                             class: "block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition duration-150" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mt-1">Minimum <%= @minimum_password_length %> znaków.</p>
        <% end %>
      </div>

      <%# Pole: Potwierdzenie Nowego Hasła %>
      <div class="space-y-2">
        <%= f.label :password_confirmation, "Potwierdź nowe hasło", class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password_confirmation, 
                             autocomplete: "new-password", 
                             placeholder: "••••••••",
                             class: "block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition duration-150" %>
      </div>

      <hr class="border-gray-100 my-4" />

      <%# Pole: Aktualne Hasło %>
      <div class="space-y-2 bg-blue-50/50 p-4 rounded-xl border border-blue-100">
        <div class="flex justify-between items-baseline mb-1">
          <%= f.label :current_password, "Aktualne hasło", class: "block text-sm font-semibold text-blue-900" %>
          <span class="text-xs text-blue-700/80 font-medium">Wymagane do zatwierdzenia zmian</span>
        </div>
        <%= f.password_field :current_password, 
                             autocomplete: "current-password", 
                             placeholder: "Wpisz obecne hasło",
                             class: "block w-full px-4 py-3 bg-white border border-blue-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150" %>
      </div>

      <% # Przyciski akcji (Zapisz / Powrót) %>
      <div class="flex items-center justify-between pt-4">
        <%= link_to "← Wróć", :back, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition duration-150" %>
        
        <%= f.submit "Zapisz zmiany", class: "px-6 py-3 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition duration-150 cursor-pointer text-center" %>
      </div>
    <% end %>
  </div>

  <% # KARTA 2: Strefa Niebezpieczna (Usuwanie konta) %>
  <div class="p-6 bg-red-50/30 border border-red-100 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h3 class="text-lg font-bold text-red-900">Usuń konto</h3>
      <p class="text-sm text-red-700/80 mt-1">Operacja jest nieodwracalna. Stracisz dostęp do wszystkich swoich postów.</p>
    </div>
    
    <%= button_to "Usuń moje konto", 
                  registration_path(resource_name), 
                  data: { confirm: "Czy na pewno chcesz usunąć konto?", turbo_confirm: "Czy na pewno chcesz usunąć konto?" }, 
                  method: :delete,
                  class: "w-full sm:w-auto px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium text-sm rounded-xl transition duration-150 cursor-pointer shadow-sm text-center" %>
  </div>

</div>