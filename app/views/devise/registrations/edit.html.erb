<div class="mx-auto my-12 w-full max-w-2xl space-y-8">
  <div class="p-8 bg-white border border-gray-100 rounded-2xl shadow-xl">
    <div class="mb-8">
      <h2 class="text-3xl font-bold text-gray-900 tracking-tight"><%= t('devise.edit_profile') %></h2>
      <p class="text-sm text-gray-500 mt-2"><%= t('devise.edit_profile_desc') %></p>
    </div>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="space-y-2">
        <%= f.label :email, t('devise.email_label'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition duration-150" %>
      </div>
      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="p-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl text-xs">
          <%= t('devise.pending_reconfirmation') %> <strong class="font-semibold"><%= resource.unconfirmed_email %></strong>
        </div>
      <% end %>
      <hr class="border-gray-100 my-4" />
      <div class="space-y-2">
        <div class="flex justify-between items-baseline">
          <%= f.label :password, t('devise.new_password'), class: "block text-sm font-medium text-gray-700" %>
          <span class="text-xs text-gray-400 italic"><%= t('devise.leave_blank') %></span>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition duration-150" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mt-1"><%= t('devise.min_characters', count: @minimum_password_length) %></p>
        <% end %>
      </div>
      <div class="space-y-2">
        <%= f.label :password_confirmation, t('devise.confirm_new_password'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition duration-150" %>
      </div>
      <hr class="border-gray-100 my-4" />
      <div class="space-y-2 bg-blue-50/50 p-4 rounded-xl border border-blue-100">
        <div class="flex justify-between items-baseline mb-1">
          <%= f.label :current_password, t('devise.current_password_label'), class: "block text-sm font-semibold text-blue-900" %>
          <span class="text-xs text-blue-700/80 font-medium"><%= t('devise.current_password_desc') %></span>
        </div>
        <%= f.password_field :current_password, autocomplete: "current-password", placeholder: t('devise.current_password_placeholder'), class: "block w-full px-4 py-3 bg-white border border-blue-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150" %>
      </div>
      <div class="flex items-center justify-between pt-4">
        <%= link_to t('devise.back_link'), :back, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition duration-150" %>
        <%= f.submit t('devise.save_changes'), class: "px-6 py-3 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition duration-150 cursor-pointer text-center" %>
      </div>
    <% end %>
  </div>
  <div class="p-6 bg-red-50/30 border border-red-100 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h3 class="text-lg font-bold text-red-900"><%= t('devise.delete_account') %></h3>
      <p class="text-sm text-red-700/80 mt-1"><%= t('devise.delete_account_desc') %></p>
    </div>
    <%= button_to t('devise.delete_account_btn'), registration_path(resource_name), data: { confirm: t('devise.delete_account_confirm'), turbo_confirm: t('devise.delete_account_confirm') }, method: :delete, class: "w-full sm:w-auto px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium text-sm rounded-xl transition duration-150 cursor-pointer shadow-sm text-center" %>
  </div>
</div>