<div class="max-w-2xl mx-auto px-4 py-6 flex flex-col h-[calc(100vh-200px)] shadow-lg rounded-3xl">
  <h1 class="text-xl font-bold border-b border-gray-100 pb-4 mb-4 text-gray-900">
    <%= @chatroom.name %>
  </h1>
  <%= turbo_stream_from @chatroom %>
  <%# Kontener na wiadomości %>
  <div class="flex-1 overflow-y-auto space-y-4 p-4 bg-emerald-50 border border-emerald-100 rounded-2xl mb-4 flex flex-col-reverse" id="messages">
    <% @messages.reverse.each do |msg| %>
      <%= render msg %>
    <% end %>
  </div>
  <%# Formularz do wysyłania wiadomości %>
  <%= form_with(model: [@chatroom, Message.new], local: true, class: "flex flex-col gap-2", id: "chat-form") do |f| %>
    <div class="flex gap-2 w-full relative">
      <%= f.text_field :body, placeholder: "#{t('chatroom.text_placeholder')}", class: "flex-1 rounded-xl border border-gray-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-emerald-400 transition bg-white", autocomplete: "off", id: "message_body_input" %>
      <div class="flex items-center gap-2 shrink-0">
        <%# Ładny przycisk %>
        <label for="message_files_input" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 text-xs font-medium rounded-xl cursor-pointer border border-gray-200 transition-colors">
          <%= t('chatroom.add_files') %>
        </label>
        <%# Ukryte oryginalne pole %>
        <%= f.file_field :attachments, multiple: true, class: "hidden", id: "message_files_input" %>
      </div>
      <%= f.submit "#{t('chatroom.send_button')}", class: "bg-emerald-600 text-white px-5 font-medium text-sm rounded-xl hover:bg-emerald-700 cursor-pointer transition-colors duration-150" %>
    </div>
    <%# Nowe miejsce na dynamiczną listę nazw wybranych plików %>
    <div id="file-list-preview" class="text-[11px] text-gray-500 px-2 font-medium hidden truncate max-w-full">
      t('chatroom.selected_files') <span id="file-names-placeholder" class="text-emerald-600"></span>
    </div>
  <% end %>
</div>
<%# Skrypty obsługujące formularz %>
<script>
  const fileInput = document.getElementById('message_files_input');
  const filePreview = document.getElementById('file-list-preview');
  const filePlaceholder = document.getElementById('file-names-placeholder');

  // Reagujemy na wybranie plików przez użytkownika
  fileInput.addEventListener('change', function() {
    if (this.files && this.files.length > 0) {
      // Wyciągamy nazwy wszystkich plików i łączymy je przecinkiem
      const names = Array.from(this.files).map(file => file.name).join(', ');

      filePlaceholder.textContent = names;
      filePreview.classList.remove('hidden'); // Pokazujemy listę
    } else {
      filePreview.classList.add('hidden'); // Ukrywamy jeśli puste
    }
  });

  // Skrypt czyszczący formularz po wysłaniu wiadomości
  document.getElementById('chat-form').addEventListener('turbo:submit-end', function(e) {
    if (e.detail.success) {
      document.getElementById('message_body_input').value = '';
      document.getElementById('message_files_input').value = '';

      // Wyczyszczenie i ukrycie podglądu załączonych nazw plików
      filePlaceholder.textContent = '';
      filePreview.classList.add('hidden');
    }
  });
</script>
<style>
  /* Style pozycjonowania dymków na podstawie ID */
  [data-sender-id="<%= current_user.id %>"] {
    justify-content: flex-end !important;
  }
  [data-sender-id="<%= current_user.id %>"] .msg-bubble {
    background-color: #059669 !important;
    color: #ffffff !important;
    border-bottom-right-radius: 0px !important;
    border-bottom-left-radius: 1rem !important;
    border-color: transparent !important;
  }
  [data-sender-id="<%= current_user.id %>"] .msg-email {
    color: #a7f3d0 !important;
  }
  [data-sender-id="<%= current_user.id %>"] .avatar-left {
    display: none !important;
  }
  [data-sender-id="<%= current_user.id %>"] .avatar-right {
    display: flex !important;
  }
</style>