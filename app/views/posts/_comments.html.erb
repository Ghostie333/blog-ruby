<%# Add comment form %>
<div class="mb-4">
  <%= form_with(model: [post, Comment.new], local: true, class: "flex flex-col gap-2") do |f| %>
    <div class="flex items-center gap-2 justify-center">
      <div class="flex-1 border border-gray-200 rounded-xl px-3 py-2 bg-gray-50 focus-within:border-emerald-400 focus-within:bg-white transition-colors">
        <%= f.rich_text_area :body,
              placeholder: "#{t('posts.write_comment')}",
              class: "block w-full min-h-[36px] max-h-[160px] overflow-y-auto bg-transparent text-sm text-gray-800 focus:outline-none resize-none" %>
      </div>
      <%= f.submit "➤",
            class: "w-9 h-9 flex items-center justify-center bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white text-base rounded-full shadow transition-all duration-150 cursor-pointer shrink-0" %>
    </div>
  <% end %>
</div>
<%# Existing comments %>
<% if post.comments.any? %>
  <div class="space-y-2">
    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1"><%= t('posts.comments') %></h3>
    <% post.comments.order(created_at: :desc).each do |comment| %>
      <% next unless comment.persisted? %>
      <div class="bg-gray-50 border border-gray-100 rounded-xl px-3 py-2 space-y-1">
        <div class="flex items-center gap-1.5">
          <% if comment.user.present? %>
            <div class="w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-[10px]">
              <% if !comment.user.avatar.attached? %>
                <%= comment.user.email[0].upcase %>
              <% else %>
                <%= image_tag comment.user.avatar, class: "w-5 h-5 rounded-full" %>
              <% end %>
            </div>
            <%= link_to comment.user.email, user_path(comment.user),
                  class: "text-xs font-semibold text-blue-500 hover:text-blue-700 hover:underline transition-colors" %>
          <% else %>
            <span class="text-xs text-gray-400 italic"><%= t('posts.anonymous_user') %></span>
          <% end %>
        </div>
        <div class="text-sm text-gray-800 leading-relaxed">
          <%= comment.body %>
        </div>
        <p class="text-[10px] text-gray-400 font-light"><%= comment.created_at.strftime("%-d %b %Y, %H:%M") %></p>
      </div>
    <% end %>
  </div>
<% end %>