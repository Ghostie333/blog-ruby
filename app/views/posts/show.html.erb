<% content_for :title, "Post:  #{@post.title}" %>
<% # Dodajemy gap-6 dla odstępu i items-start, żeby kolumny nie rozciągały się w pionie %>
<div class="flex flex-col md:flex-row gap-6 items-start w-full max-w-7xl mx-auto px-4">
  <%# 1. Kontener na posta (zajmuje główną przestrzeń) %>
  <div class="flex-1 w-full min-w-0">
    <% # min-w-0 jest KLUCZOWE dla Trixa i długich tekstów, żeby nie rozpychały Flexboxa %>
    <div class="p-6">
      <h1 class="font-bold text-2xl md:text-4xl tracking-tight mb-4">
        <%= t('posts.user_post')%>
        <span class="text-blue-500 hover:underline">
          <%= link_to @post.user.email, user_path(@post.user) %>
        </span>
      </h1>
      <div class="my-5">
        <%= render @post %>
      </div>
      <% # Kontener na przyciski w jednym rzędzie %>
      <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-gray-100">
        <%= link_to "#{t('posts.back_to_posts')}", posts_path, class: "rounded-xl px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium text-sm transition-colors text-center" %>
        <% if @post.user == current_user %>
          <%= link_to "#{t('posts.edit_post')}", edit_post_path(@post), class: "rounded-xl px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium text-sm transition-colors text-center" %>
          <%= button_to "#{t('posts.delete_post')}", @post, method: :delete, form_class: "inline-block", class: "rounded-xl px-4 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium text-sm transition-colors cursor-pointer", data: { turbo_confirm: "#{t('posts.delete_confirm')}" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>