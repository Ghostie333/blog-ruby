<div id="<%= dom_id post %>" class="bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all duration-200 p-5 space-y-3">
  <!-- Author -->
  <div class="flex items-center gap-2">
    <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-sm">
      <%= post.user.email[0].upcase %>
    </div>
    <span class="text-sm font-semibold text-gray-800">
      <%= link_to post.user.email, user_path(post.user) %>
    </span>
  </div>
  <!-- Title -->
  <h2 class="text-lg font-bold text-gray-900 leading-snug"><%= post.title %></h2>
  <!-- Content -->
  <div class="text-gray-700 text-sm leading-relaxed border-l-4 border-emerald-300 pl-3">
    <%= post.content %>
  </div>
  <!-- Date -->
  <p class="text-xs text-gray-400 font-light"><%= post.created_at.strftime("%-d %b %Y, %H:%M") %></p>
  <!-- Comments -->
  <div class="pt-2 border-t border-gray-100">
    <%= render "posts/comments", post: post %>
  </div>
</div>