<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Super Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Super Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col" data-controller="friend-list">
    <%# Przeniesione do wewnątrz body, żeby przycisk był w zasięgu kontrolera %>
    <header class="fixed top-0 left-0 right-0 z-50">
      <%= render "layouts/navbar" %>
    </header>
    <main class="w-full max-w-[1600px] mx-auto mt-16 flex-1 flex relative">
      <%= render "layouts/toasts" %>
      <%# Panel po lewej - Grupy %>
      <% if current_user.present? %>
        <%= turbo_frame_tag "group_list_widget", src: groups_path do %>
          <div class="max-w-4xl mx-auto px-4 py-8 text-center text-gray-400 animate-pulse">
            <%= t('groups.loading', default: "Ładowanie grup...") %>
          </div>
        <% end %>
      <% end %>
      <%# Sekcja środkowa - zawartość aktualnej podstrony %>
      <div class="flex-1 px-4 py-6 md:px-8 overflow-x-hidden">
        <%= yield %>
      </div>
      <% if current_user.present? %>
        <%= turbo_frame_tag "friend_list_widget", src: friendships_path do %>
          <div class="max-w-4xl mx-auto px-4 py-8 text-center text-gray-400 animate-pulse">
            <%= t('friendship.loading', default: "Ładowanie listy znajomych...") %>
          </div>
        <% end %>
      <% end %>
    </main>
    <div class="z-40">
      <%= render "posts/create_post_button" %>
    </div>
  </body>
</html>