<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Super Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Super Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col" data-controller="friend-list">
    <header class="fixed top-0 left-0 right-0 z-50">
      <%= render "layouts/navbar" %>
    </header>
    <main class="w-full max-w-[1600px] mx-auto mt-16 flex-1 flex items-start relative px-4 gap-6">
      <%= render "layouts/toasts" %>
      <%# PANEL PO LEWEJ - GRUPY (Sztywno zablokowane na 300px) %>
      <% if current_user.present? %>
        <aside class="w-[300px] max-w-[300px] shrink-0 sticky top-20 bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mt-6 min-w-0 overflow-hidden">
          <%= turbo_frame_tag "group_list_widget", src: groups_path do %>
            <div class="py-8 text-center text-gray-400 animate-pulse text-sm">
              <%= t('groups.loading', default: "Ładowanie grup...") %>
            </div>
          <% end %>
        </aside>
      <% end %>
      <%# SEKCJA ŚRODKOWA - ZAWARTOŚĆ STRONY %>
      <div class="flex-1 min-w-0 py-6 overflow-x-hidden">
        <%= yield %>
      </div>
      <%# SEKCJA PO PRAWEJ - ZNAJOMI (Sztywno zablokowane na 300px) %>
      <% if current_user.present? %>
        <aside class="w-[300px] max-w-[300px] shrink-0 sticky top-20 bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mt-6 min-w-0 overflow-hidden">
          <%= turbo_frame_tag "friend_list_widget", src: friendships_path do %>
            <div class="py-8 text-center text-gray-400 animate-pulse text-sm">
              <%= t('friendship.loading', default: "Ładowanie listy znajomych...") %>
            </div>
          <% end %>
        </aside>
      <% end %>
    </main>
    <div class="z-40">
      <%= render "posts/create_post_button" %>
    </div>
  </body>
</html>