<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Super Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Super Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col" data-controller="friend-list">
    <%# Przeniesione do wewnątrz body, żeby przycisk był w zasięgu kontrolera %>
    <header class="fixed top-0 left-0 right-0 z-50">
      <%= render "layouts/navbar" %>
    </header>
    <main class="w-full max-w-[1600px] mx-auto mt-16 flex-1 flex relative">
      <%= render "layouts/toasts" %>
      <%# Panel po lewej - Grupy %>
      <%# Dla PC %>
      <% if current_user.present? %>
        <section class="hidden lg:block w-80 shrink-0 border-r border-gray-200 h-[calc(100vh-4rem)] sticky top-16 bg-white overflow-y-auto">
          <%= render "groups/group_list" %>
        </section>
      <% end %>
      <%# Sekcja środkowa - zawartość aktualnej podstrony %>
      <div class="flex-1 px-4 py-6 md:px-8 overflow-x-hidden">
        <%= yield %>
      </div>
      <% if current_user.present? %>
        <%# Panel dla PC %>
        <section class="hidden lg:block w-80 shrink-0 border-l border-gray-200 h-[calc(100vh-4rem)] sticky top-16 bg-white overflow-y-auto">
          <%= render "friendships/friend_list" %>
        </section>
        <%# Panel dla telefonów %>
        <div data-friend-list-target="friend-list" data-action="click->friend-list#close" class="hidden fixed inset-0 bg-black/40 z-40 transition-opacity lg:hidden"></div>
        <div data-friend-list-target="drawer" class="fixed top-0 right-0 bottom-0 w-80 max-w-[calc(100vw-3rem)] bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden overflow-y-auto p-4">
          <div class="flex justify-between items-center mb-4 pb-2 border-b">
            <span class="font-bold text-lg">Znajomi</span>
            <button data-action="click->friend-list#close" class="p-2 text-gray-500 hover:text-black text-xl">✕</button>
          </div>
          <%= render "friendships/friend_list" %>
        </div>
      <% end %>
    </main>
    <div class="z-40">
      <%= render "posts/create_post_button" %>
    </div>
  </body>
</html>