<nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-sm border-b border-gray-100 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="shrink-0">
        <%= link_to posts_path, class: "flex items-center space-x-2 text-xl font-bold text-gray-900 hover:text-emerald-600 transition duration-150" do %>
          <span class="bg-emerald-600 text-white px-2.5 py-1.5 rounded-xl text-sm font-black tracking-wider shadow-sm">SB</span>
          <span>Super Blog</span>
        <% end %>
      </div>
      <div class="flex items-center space-x-4">
        <div class="flex gap-2 text-sm font-medium">
          <%= link_to "🇵🇱 PL", url_for(locale: :pl), class: I18n.locale == :pl ? "text-emerald-600 font-bold" : "text-gray-500" %>
          <span class="text-gray-300">|</span>
          <%= link_to "🇬🇧 EN", url_for(locale: :en), class: I18n.locale == :en ? "text-emerald-600 font-bold" : "text-gray-500" %>
        </div>
        <% if user_signed_in? %>
          <%# 1. Subskrypcja kanału WebSocket ukryta w tle %>
          <%= turbo_stream_from "notifications_#{current_user.id}" %>
          <%# Twój oryginalny div trzymający elementy po prawej %>
          <div class="flex items-center space-x-4">
            <div class="relative flex items-center" id="notifications-wrapper">
              <%# Kontener-wrapper dla dynamicznej podmiany przez Turbo Stream %>
              <div id="notifications-counter">
                <%= render "notifications/counter", count: current_user.notifications.unread.count %>
              </div>
              <div id="notifications-menu" class="absolute right-0 top-full mt-3 z-50 origin-top-right hidden w-80 bg-white rounded-2xl shadow-xl border border-gray-100">
                <%= turbo_frame_tag "notifications_widget_frame", src: notifications_path(format: :turbo_stream), loading: :lazy do %>
                  <div class="p-4 text-center text-xs text-gray-400">
                    Ładowanie powiadomień...
                  </div>
                <% end %>
              </div>
            </div>
            <%= link_to user_path(current_user), class: "flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-emerald-50 transition duration-150 group" do %>
              <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-xs overflow-hidden">
                <% if !current_user.avatar.attached? %>
                  <%= current_user.email[0].upcase %>
                <% else %>
                  <%= image_tag current_user.avatar, class: "w-7 h-7 rounded-full object-cover" %>
                <% end %>
              </div>
              <span class="text-sm font-medium text-gray-600 group-hover:text-emerald-700 hidden sm:block">
                <%= current_user.email %>
              </span>
            <% end %>
            <button data-action="click->friend-list#open" class="block lg:hidden p-2 bg-gray-100 hover:bg-gray-200 rounded-xl px-3 py-1.5 text-sm font-bold cursor-pointer">
              <%= t('navbar.friends') %>
            </button>
            <%= link_to "#{t('navbar.logout')}",
                  destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "px-4 py-2 text-sm font-medium text-gray-600 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition duration-150" %>
          </div>
        <% else %>
          <%= link_to "#{t('navbar.login')}",
                new_user_session_path,
                class: "px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 rounded-xl shadow-sm hover:shadow transition duration-150" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
<script>
  (function() {
    // Zapobiegamy wielokrotnemu deklarowaniu tych samych funkcji przy przejściach Turbo
    if (window.notificationsBound) return;

    // Używamy mousedown, ponieważ odpala się zanim Turbo zdąży podmienić lub zablokować click
    document.addEventListener("mousedown", function(e) {
      const menu = document.getElementById("notifications-menu");
      const wrapper = document.getElementById("notifications-wrapper");

      // Szukamy przycisku dzwonka w strukturze
      const bellBtn = e.target.closest("#notifications-wrapper button") || e.target.closest("#notifications-counter button");

      if (bellBtn && menu) {
        e.preventDefault();
        e.stopPropagation();

        // Przełącz widoczność menu
        menu.classList.toggle("hidden");

        // Natychmiast usuwamy czerwone kropki / liczniki z przycisku
        const badges = bellBtn.querySelectorAll("span");
        badges.forEach(b => b.remove());

        // Przeładowujemy ramkę powiadomień, jeśli menu zostało otwarte
        const frame = document.getElementById("notifications_widget_frame");
        if (frame && !menu.classList.contains("hidden")) {
          frame.reload();
        }
        return;
      }

      // Zamknij okienko, jeśli kliknięto gdziekolwiek indziej poza wrapperem
      if (wrapper && menu && !wrapper.contains(e.target)) {
        menu.classList.add("hidden");
      }
    });

    window.notificationsBound = true;
  })();
</script>