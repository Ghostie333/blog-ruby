<% content_for :title, "Konto #{@user.email}" %>
<div class="mx-auto min-w-xl w-full max-w-4xl px-4 py-6">
  <% # Nagłówek profilu %>
  <div class="flex justify-between items-center mb-8 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
    <div>
      <h1 class="font-bold text-4xl text-gray-900 tracking-tight"><%= t('user.user_account') %></h1>
      <p class="text-gray-500 mt-1 font-medium"><%= @user.email %></p>
    </div>
    <% if current_user == @user %>
      <%= link_to "#{t('user.change_password')}", edit_user_registration_path, class: "px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-blue-800 text-white font-medium text-sm rounded-xl shadow-sm hover:shadow transition duration-150 cursor-pointer" %>
    <% end %>
  </div>
  <h2 class="text-2xl font-bold text-gray-900 mb-4"><%= t('user.user_posts') %> (<%= @user.posts.count %>)</h2>
  <% # Sprawdzenie i wyświetlenie postów w ładnej siatce %>
  <% if @user.posts.any? %>
    <div id="posts" class="columns-1 md:columns-2 gap-8 space-y-8 [column-fill:_balance] w-full mt-6">
      <% @user.posts.each do |post| %>
        <div class="break-inside-avoid inline-block w-full">
          <%= render post %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 border border-gray-100 rounded-2xl p-12 text-center mt-6">
      <p class="text-gray-400 italic"><%= t('user.no_user_posts') %></p>
    </div>
  <% end %>
</div>