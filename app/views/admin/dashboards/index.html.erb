<div class="p-6 max-w-7xl mx-auto min-h-screen bg-gray-50/30">
  <div class="flex items-center gap-3 mb-8">
    <div class="p-2 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
      </svg>
    </div>
    <h1 class="text-3xl font-black text-gray-900 tracking-tight"><%= t('admin_dashboard.dashboard') %></h1>
  </div>
  <%# Widżet zbanowanych IP %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <div class="w-full max-h-[500px] overflow-y-auto rounded-2xl">
      <%= turbo_frame_tag "banned_ips_widget", src: admin_banned_ips_path do %>
        <div class="p-8 bg-white rounded-2xl border border-gray-100 shadow-sm text-center flex flex-col items-center justify-center min-h-[250px] animate-pulse">
          <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-500 flex items-center justify-center mb-3">
            <span class="w-2 h-2 bg-rose-500 rounded-full animate-ping"></span>
          </div>
          <p class="text-sm font-semibold text-gray-400 tracking-medium"><%= t('admin_dashboard.loading_banned_ip_widget') %></p>
        </div>
      <% end %>
    </div>
    <%# Widżet użytkowników %>
    <div class="w-full max-h-[500px] overflow-y-auto rounded-2xl">
      <%= turbo_frame_tag "users_widget", src: admin_users_path do %>
        <div class="p-8 bg-white rounded-2xl border border-gray-100 shadow-sm text-center flex flex-col items-center justify-center min-h-[250px] animate-pulse">
          <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-500 flex items-center justify-center mb-3">
            <span class="w-2 h-2 bg-amber-500 rounded-full animate-ping"></span>
          </div>
          <p class="text-sm font-semibold text-gray-400 tracking-medium"><%= t('admin_dashboard.loading_user_widget') %></p>
        </div>
      <% end %>
    </div>
    <%# Widżet logów %>
    <div class="lg:col-span-2 w-full max-h-[800px] min-h-[450px] overflow-y-auto rounded-2xl">
      <%= turbo_frame_tag "activity_logs_widget", src: admin_activity_logs_path do %>
        <div class="p-12 bg-white rounded-2xl border border-gray-100 shadow-sm text-center flex flex-col items-center justify-center min-h-[450px] animate-pulse">
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 animate-spin">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-gray-400 tracking-medium"><%= t('admin_dashboard.loading_activity_logs_widget') %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>