<%# app/views/admin/banned_ips/index.html.erb %>
<%= turbo_frame_tag "banned_ips_widget" do %>
  <div class="p-3">
    <h2 class="text-xl font-bold text-gray-800 mb-4"><%= t('admin_dashboard.banned_ips') %></h2>
    <%= form_with(model: [:admin, @new_banned_ip], class: "flex gap-2 mb-6") do |f| %>
      <%= f.text_field :ip_address, placeholder: "np. 127.0.0.1", class: "border rounded-lg px-3 py-2 text-sm w-full" %>
      <%= f.submit "Zbanuj IP", data: { turbo_frame: "_top" }, class: "bg-red-500 text-white text-sm px-4 py-2 rounded-lg font-medium cursor-pointer" %>
    <% end %>
    <%# Wyświetlanie już zbanowanych IP %>
    <div class="divide-y divide-gray-100">
      <% @banned_ips.each do |banned| %>
        <div class="flex justify-between items-center p-3 border border-gray-300 rounded-lg shadow-md">
          <span class="font-mono text-md"><%= banned.ip_address %></span>
          <%= button_to "Odblokuj", admin_banned_ip_path(banned), method: :delete, data: { turbo_confirm: "Odblokować?", turbo_frame: "_top"}, class: "bg-red-500 text-white text-sm px-4 py-2 rounded-lg font-medium cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>