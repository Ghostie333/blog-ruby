<% content_for :title, "#{t('posts.post_editing')}" %>
<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t('posts.post_editing') %></h1>
  <%= render "form", post: @post %>
  <%= link_to "#{t('posts.show_post')}", @post, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "#{t('posts.back_to_posts')}", posts_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
