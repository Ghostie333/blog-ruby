<% content_for :title, "Post:  #{@post.title}" %>
<div class="flex flex-row">
  <%# Kontener na posta %>
  <div class="w-full max-w-2xl mx-auto px-4 py-6">
    <h1 class="font-bold text-4xl">
      <%= t('posts.user_post')%> <span class="text-blue-400"><%= link_to @post.user.email, user_path(@post.user) %></span>
    </h1>
    <div class="my-5">
      <%= render @post %>
    </div>
    <%= link_to "#{t('posts.back_to_posts')}", admin_posts_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>