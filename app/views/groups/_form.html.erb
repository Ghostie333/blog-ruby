<%= form_with(model: group, class: "contents") do |form| %>
  <% if group.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(group.errors.count, "error") %></h2>
      <ul class="list-disc ml-6">
        <% group.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="my-5">
    <%= form.label "#{t('groups.name')}" %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": group.errors[:name].none?, "border-red-400 focus:outline-red-600": group.errors[:name].any?}] %>
  </div>
  <div>
    <%= form.label "#{t('groups.add_photo')}" %>
    <%= form.file_field :group_picture %>
  </div>
  <div class="inline">
    <%= form.submit "#{t('groups.create_group')}", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
