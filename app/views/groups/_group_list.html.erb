<div class="max-w-4xl mx-auto px-4 py-8">
  <%= link_to groups_path do %>
    <h1 class="text-3xl font-bold text-gray-900 mb-8"><%= t('groups.groups') %></h1>
  <% end %>
  <%# 1. Sekcja utwórz grupę %>
  <%= link_to new_group_path do %>
    <div><%= t('groups.create_group') %></div>
  <% end %>
  <%# 2. Sekcja grup do których należy User %>
  <% all_groups = current_user.groups %>
  <div>
    <%# Lista znajomych %>
    <h2 class="text-xl font-semibold text-gray-900 mb-4"><%= t('groups.user_groups') %> (<%= all_groups.count %>)</h2>
    <% if all_groups.any? %>
      <div class="space-y-3">
        <% all_groups.each do |group| %>
          <div class="flex justify-between items-center bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all duration-200 p-3 gap-3">
            <%= render group %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 text-center">
        <p class="text-gray-400 text-sm italic"><%= t('groups.not_belong_to_group') %></p>
      </div>
    <% end %>
  </div>
</div>