<%# app/views/groups/index.html.erb %>
<%= turbo_frame_tag "group_list_widget" do %>
  <% if turbo_frame_request? %>
    <%# Widok dla widżetu %>
    <div class="w-full py-4">
      <%= link_to groups_path, data: { turbo: false } do %>
        <h1 class="text-2xl font-bold text-gray-900 mb-6 hover:text-emerald-600 transition-colors"><%= t('groups.groups') %></h1>
      <% end %>
      <%= link_to new_group_path, data: { turbo: false } do %>
        <div class="mb-4 inline-block text-xs font-medium text-emerald-600 hover:text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-xl transition-colors duration-150">
          <%= t('groups.create_group') %>
        </div>
      <% end %>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-3">
          <%= t('groups.user_groups') %> (<%= @groups.count %>)
        </h2>
        <% if @groups.any? %>
          <div class="space-y-2">
            <% @groups.each do |group| %>
              <div class="flex justify-between items-center bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all duration-200 p-3 gap-3 text-xs">
                <%= render group %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 text-center">
            <p class="text-gray-400 text-xs italic"><%= t('groups.not_belong_to_group') %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%# Widok pełnej strony (pozostaje bez zmian dla głównego routingu) %>
    <div class="max-w-4xl mx-auto px-4 py-8">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900"><%= t('groups.all_groups') %></h1>
        <%= link_to new_group_path, data: { turbo: false } do %>
          <div class="mb-6 inline-block text-sm font-medium text-emerald-600 hover:text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-xl transition-colors duration-150">
            <%= t('groups.create_group') %>
          </div>
        <% end %>
      </div>
      <% if @groups.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @groups.each do |group| %>
            <div class="p-4 bg-white border border-gray-200 rounded-2xl shadow-sm">
              <%= render group %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 italic"><%= t('groups.groups_not_found') %></p>
      <% end %>
    </div>
  <% end %>
<% end %>