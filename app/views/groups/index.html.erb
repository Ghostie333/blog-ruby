<%# app/views/groups/index.html.erb %>
<%= turbo_frame_tag "group_list_widget" do %>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <% if turbo_frame_request? %>
      <%# Widok dla widżetu %>
      <%= link_to groups_path, data: { turbo: false } do %>
        <h1 class="text-3xl font-bold text-gray-900 mb-8"><%= t('groups.groups') %></h1>
      <% end %>
      <%= link_to new_group_path, data: { turbo: false } do %>
        <div class="mb-6 inline-block text-sm font-medium text-emerald-600 hover:text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-xl transition-colors duration-150">
          <%= t('groups.create_group') %>
        </div>
      <% end %>
      <div>
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          <%= t('groups.user_groups') %> (<%= @groups.count %>)
        </h2>
        <% if @groups.any? %>
          <div class="space-y-3">
            <% @groups.each do |group| %>
              <div class="flex justify-between items-center bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all duration-200 p-3 gap-3">
                <%= render group %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 text-center">
            <p class="text-gray-400 text-sm italic"><%= t('groups.not_belong_to_group') %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Widok pełnej strony %>
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900"><%= t('groups.all_groups') %></h1>
        <%= link_to t('groups.create_group'), new_group_path, class: "bg-emerald-600 text-white px-4 py-2 rounded-xl hover:bg-emerald-700 text-sm font-medium" %>
      </div>
      <% if @groups.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @groups.each do |group| %>
            <div class="p-4 bg-white border border-gray-200 rounded-2xl shadow-sm">
              <%= render group %>
              <%# Tutaj możesz dodać np. przycisk "Dołącz do grupy", jeśli użytkownik jeszcze w niej nie jest %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 italic"><%= t('groups.groups_not_found') %></p>
      <% end %>
    <% end %>
  </div>
<% end %>