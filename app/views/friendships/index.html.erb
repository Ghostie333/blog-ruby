<%# app/views/friendships/index.html.erb %>
<%= turbo_frame_tag "friend_list_widget" do %>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8"><%= t('friendship.friends') %></h1>
    <%# 1. Sekcja zaproszeń oczekujących %>
    <div class="mb-10 bg-emerald-50 border border-emerald-100 p-6 rounded-2xl">
      <h2 class="text-md font-semibold text-emerald-900 mb-4">
        <%= t('friendship.incoming_invitations') %> (<%= @incoming_invitations.count %>)
      </h2>
      <% if @incoming_invitations.any? %>
        <div class="space-y-3">
          <% @incoming_invitations.each do |invitation| %>
            <div class="flex justify-between items-center bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all duration-200 p-4">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-sm">
                  <%= invitation.user.email[0].upcase %>
                </div>
                <span class="font-medium text-gray-800"><%= invitation.user.email %></span>
              </div>
              <div class="flex gap-2">
                <%= button_to "#{t('friendship.accept_btn')}", friendship_path(invitation), method: :patch,
                      class: "px-4 py-1.5 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors duration-150 cursor-pointer" %>
                <%= button_to "#{t('friendship.delcine_btn')}", friendship_path(invitation), method: :delete,
                      class: "px-4 py-1.5 bg-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-300 transition-colors duration-150 cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-emerald-700 text-sm italic"><%= t('friendship.no_new_invitations') %></p>
      <% end %>
    </div>
    <%# 2. Sekcja aktualnych znajomych %>
    <div>
      <h2 class="text-xl font-semibold text-gray-900 mb-4"><%= t('friendship.your_friends') %> (<%= @all_friends.count %>)</h2>
      <%# Formularz dodawania znajomego %>
      <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-5 mb-6 space-y-3">
        <h3 class="text-sm font-semibold text-gray-700"><%= t('friendship.add_friend') %></h3>
        <%= form_with(url: friendships_path, method: :post, class: "flex gap-2") do |f| %>
          <%= f.email_field :email,
                class: "border border-gray-200 rounded-xl px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-emerald-400 transition",
                placeholder: "friend@email.com",
                required: true %>
          <%= f.submit "#{t('friendship.add_friend_btn')}",
                class: "bg-emerald-600 text-white text-sm font-medium px-4 py-2 rounded-xl hover:bg-emerald-700 cursor-pointer transition-colors duration-150 whitespace-nowrap" %>
        <% end %>
      </div>
      <%# Lista znajomych %>
      <% if @all_friends.any? %>
        <div class="space-y-3">
          <% @all_friends.each do |friend| %>
            <div class="flex justify-between items-center bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all duration-200 p-3 gap-3">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-sm">
                  <%= friend.email[0].upcase %>
                </div>
                <span class="font-semibold text-gray-800 text-sm"><%= friend.email %></span>
              </div>
              <%# data: { turbo: false } dodajemy, żeby przejście do czatu przeładowało całą stronę, a nie utknęło w małym okienku widgetu %>
              <%= button_to "#{t('friendship.send_message_btn')}", chatrooms_path(friend_id: friend.id), method: :post,
                    data: { turbo: false },
                    class: "px-4 py-1.5 bg-emerald-600 text-white text-sm font-medium rounded-xl hover:bg-emerald-700 transition-colors duration-150 cursor-pointer" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 text-center">
          <p class="text-gray-400 text-sm italic"><%= t('friendship.no_friends') %></p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>