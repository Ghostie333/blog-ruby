<%# Kod dzwonka powiadomień %>
<% count ||= 0 %>
<% has_unread ||= false %>
<% size ||= "md" %>
<% theme ||= "light" %>
<%
  sizes = {
    "sm" => { btn: "w-8 h-8",   icon: "w-4 h-4", badge_pos: "-top-1 -right-1",   badge_size: "min-w-4 h-4 px-1 text-[10px]",  dot_size: "w-2 h-2" },
    "md" => { btn: "w-10 h-10", icon: "w-5 h-5", badge_pos: "-top-1 -right-1",   badge_size: "min-w-5 h-5 px-1.5 text-xs",    dot_size: "w-2.5 h-2.5" },
    "lg" => { btn: "w-12 h-12", icon: "w-6 h-6", badge_pos: "-top-1.5 -right-1.5", badge_size: "min-w-6 h-6 px-2 text-sm",   dot_size: "w-3 h-3" }
  }
  s = sizes[size] || sizes["md"]

  theme_classes = theme == "dark" ?
    "text-gray-400 hover:text-white hover:bg-gray-800 focus:ring-gray-700 focus:ring-offset-gray-900" :
    "text-gray-500 hover:text-gray-900 hover:bg-gray-100 focus:ring-gray-200 focus:ring-offset-white"

  ring_class = theme == "dark" ? "ring-gray-900" : "ring-white"

  display_count = count > 99 ? "99+" : count.to_s
  show_badge = count > 0
  show_dot   = has_unread && count == 0
%>
<button type="button" id="bell-icon-button"
  class="relative inline-flex items-center justify-center rounded-full transition-all duration-200
         focus:outline-none focus:ring-2 focus:ring-offset-2
         <%= s[:btn] %> <%= theme_classes %>">
  <%# Bell icon %>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
       stroke-width="1.75" stroke="currentColor" class="<%= s[:icon] %>">
    <path stroke-linecap="round" stroke-linejoin="round"
      d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.75a6 6 0 00-12
         0v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255
         0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
  </svg>
  <%# Number badge %>
  <% if show_badge %>
    <span class="absolute flex items-center justify-center rounded-full font-semibold
                 text-white bg-gradient-to-tr from-red-600 to-rose-500 shadow-sm leading-none
                 ring-2 <%= ring_class %> <%= s[:badge_size] %> <%= s[:badge_pos] %>">
      <%= display_count %>
    </span>
  <% end %>
  <%# Unread dot (no count) %>
  <% if show_dot %>
    <span class="absolute flex items-center justify-center top-0 right-0 <%= s[:dot_size] %>">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-rose-400 opacity-75"></span>
      <span class="relative inline-flex h-full w-full rounded-full bg-gradient-to-tr from-red-600 to-rose-500 ring-2 <%= ring_class %>"></span>
    </span>
  <% end %>
</button>